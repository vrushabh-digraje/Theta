               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>â€¢ Support for AI306 : AMS 2750H compliance enables higher PR ac</photoshop:LayerName>
                  <photoshop:LayerText>â€¢ Support for AI306 : AMS 2750H compliance enables higher PR accuracy and facilitates      precise thermal process control.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>â€¢ Energy Management System (EMS) Power Management Feature : Rec</photoshop:LayerName>
                  <photoshop:LayerText>â€¢ Energy Management System (EMS) Power Management Feature : Records and       displays real-time power status on the user interface (UI).</photoshop:LayerText>
               </rdf:li>
